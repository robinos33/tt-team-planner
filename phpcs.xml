<?xml version="1.0"?>
<ruleset name="TT Team Planner">
    <description>PHPCS configuration for TT Team Planner.</description>

    <file>.</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <!-- Mise en forme : PSR-12, le style dans lequel le code est écrit.
         Les règles de mise en forme de WordPress (tabulations, espaces dans
         les parenthèses, array()) n'ont jamais été appliquées ici. -->
    <rule ref="PSR12">
        <!-- Les requêtes SQL et les phpcs:ignore font des lignes longues. -->
        <exclude name="Generic.Files.LineLength"/>
        <!-- Garde « ) {} » pour un constructeur à promotion de propriétés,
             comme le permet PER-CS 2.0, successeur de PSR-12. -->
        <exclude name="Squiz.WhiteSpace.ScopeClosingBrace.ContentBefore"/>
    </rule>

    <!-- Le fichier principal et uninstall.php sont des points d'entrée WordPress :
         ils déclarent et exécutent à la fois. -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>tt-team-planner.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
    </rule>

    <!-- Règles WordPress qui portent du sens : sécurité, SQL, API WordPress. -->
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.WP">
        <!-- StandaloneTemplate bypasses WP template system intentionally (app shell) -->
        <exclude name="WordPress.WP.EnqueuedResources.NonEnqueuedStylesheet"/>
        <exclude name="WordPress.WP.EnqueuedResources.NonEnqueuedScript"/>
    </rule>
    <rule ref="WordPress.PHP">
        <exclude name="WordPress.PHP.YodaConditions"/>
    </rule>

    <!-- Declare acceptable prefixes: TT\TeamPlanner (namespace) and ttp (functions/variables) -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="TT\TeamPlanner"/>
                <element value="ttp_"/>
                <element value="TTP_"/>
            </property>
        </properties>
    </rule>

    <!-- Repository pattern : direct DB queries with custom tables are intentional.
         $this->table is set from $wpdb->prefix in constructors — not user input. -->
    <rule ref="WordPress.DB.DirectDatabaseQuery.DirectQuery">
        <exclude-pattern>includes/Repository/*</exclude-pattern>
        <exclude-pattern>includes/Rest/SeasonController.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.DB.DirectDatabaseQuery.NoCaching">
        <exclude-pattern>includes/Repository/*</exclude-pattern>
        <exclude-pattern>includes/Rest/SeasonController.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
    </rule>
    <!-- {$this->table} is safe: value comes from $wpdb->prefix in constructor, not user input -->
    <rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
        <exclude-pattern>includes/Repository/*</exclude-pattern>
    </rule>

    <!-- monclubtt_get_joueurs is an external hook from the MonClubTT dependency plugin -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
        <exclude-pattern>includes/Rest/SyncController.php</exclude-pattern>
    </rule>
</ruleset>
