# Fichiers exclus du ZIP de distribution (git archive --worktree-attributes)
# Utilisé par .github/workflows/release-zip.yml pour construire l'archive
# attachée à chaque release GitHub — installable directement depuis
# Extensions → Ajouter → Téléverser une extension dans wp-admin.
.gitattributes    export-ignore
.gitignore        export-ignore
README.md         export-ignore
CONTRIBUTING.md   export-ignore
CLAUDE.md         export-ignore
composer.json     export-ignore
composer.lock     export-ignore
package.json      export-ignore
package-lock.json export-ignore
phpcs.xml         export-ignore
phpunit.xml       export-ignore
tests/            export-ignore
.claude/          export-ignore
.github/          export-ignore
.idea/            export-ignore
